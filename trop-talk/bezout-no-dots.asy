size(500, 500);

pen p = rgb(0.5, 0.5, 1) + 10;
pen q = rgb(1, 0.5, 0.5) + 10;

draw((0,0)--(1,0)--(2,1)--(2,2)--(1,2)--(0,1)--(0,0), p);

draw((0,0) -- (-1,-1), p);
draw((-2,-1) -- (-1,-1) -- (-1, -2), p);

draw((1,0) -- (1,-2), p);
draw((0,1) -- (-2,1), p);

draw((2,1) -- (3,1), p);
draw((4,2) -- (3,1) -- (3,-2), p);

draw((1,2) -- (1,3), p);
draw((2,4) -- (1,3) -- (-2,3), p);

draw((2,2) -- (4,4), p);

draw((-2,0.5) -- (0.25, 0.5) -- (0.25, -2), q);
draw((0.25, 0.5) -- (1.25, 1.5), q);
draw((1.25, 1.8) -- (1.25, 1.5) -- (2.75, 1.5), q);
draw((-2, 1.8) -- (1.25, 1.8) -- (3.45, 4), q);
draw((4, 2.75) -- (2.75, 1.5) -- (2.75, -2), q);
